# Telegram Bot Configuration
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Allowed Users (comma-separated Telegram user IDs)
ALLOWED_USER_IDS=123456789,987654321

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API (optional, fallback)
OPENAI_API_KEY=your_openai_api_key_here

# Google Sheets API
GOOGLE_SHEETS_CREDENTIALS_FILE=credentials.json
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Database
# Local SQLite (default):
DATABASE_URL=sqlite+aiosqlite:///./fuel_tracker.db
# Railway Postgres — only for migration from this machine (bot on Railway uses DATABASE_URL from dashboard):
# POSTGRES_URL=postgresql://...
# Railway: add PostgreSQL in the project, open Variables on the Postgres service and copy
# DATABASE_URL / DATABASE_PUBLIC_URL, paste into the bot service as DATABASE_URL.
# postgresql:// and postgres:// are auto-converted to postgresql+asyncpg:// at startup.
# Migrate existing SQLite → Postgres once from your machine:
#   export DATABASE_URL='postgresql://...'
#   python scripts/migrate_sqlite_to_postgres.py --sqlite data/fuel_tracker.db

# Logging
LOG_LEVEL=INFO
